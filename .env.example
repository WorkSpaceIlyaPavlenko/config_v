# Copy to .env in the project root, or select --env-file PATH.
# Data only: no shell expansion, passwords, private keys or client UUIDs.
# CLI flags override process VPN_* variables, which override this file.
VPN_MODE=production
VPN_NODE=de-main
VPN_DOMAIN=connect.example.com
VPN_ADDRESS=connect.example.com
VPN_DOCKER_HOST=ssh://deploy@server.example.com
VPN_PORT=443
VPN_HTTP_PORT=80
VPN_BIND_ADDRESS=0.0.0.0

# Optional DNS resolvers for the containers. This does NOT create public DNS
# records or change the VPS OS DNS. Empty = Docker daemon defaults.
VPN_DNS_SERVERS=
VPN_XRAY_MEMORY_MB=256
VPN_CADDY_MEMORY_MB=128
VPN_XRAY_CPUS=1
VPN_CADDY_CPUS=0.5
# First device only, while creating a new node. Add more with vpn:add-client.
# VPN_CLIENT=device-one

# Colima VM settings are local-only; use deploy/local.env.example.
# VPN_VM_HOSTNAME=colima-config-v
# VPN_VM_DNS_SERVERS=

# For a local run without editing a file:
# npm run init -- --local --env-file deploy/local.env.example
# Do not combine the production settings above with a local run. Use separate
# env files for different nodes; an explicit --env-file must exist.
